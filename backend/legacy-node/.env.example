# ─── Servidor ────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Supabase (Recomendado para Produção / Piloto) ────────
SUPABASE_URL=https://xozcsujnjzoinqhifgfm.supabase.co
SUPABASE_ANON_KEY=sua_chave_anon_publica
SUPABASE_SERVICE_ROLE_KEY=sua_chave_service_role

# ─── PostgreSQL + PostGIS Local (Opcional) ────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rede_apoio?schema=public

# ─── Redis ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── CORS ────────────────────────────────────────────────
# Origens permitidas (separadas por vírgula)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Localização Temporária ──────────────────────────────
# URL base para montar o link de compartilhamento
SHARE_BASE_URL=http://localhost:5173/track

# Duração máxima de sessão em minutos
SHARE_MAX_DURATION_MIN=60

# ─── Rate Limiting ───────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
