# API ARQUIVADA (25/09/2026): não é usada pelo app. O backend oficial é o
# Supabase em backend/supabase/. Copie para .env e nunca versione valores reais.

# ─── Servidor ────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Supabase ────────────────────────────────────────────
# Painel → Project Settings → API Keys. O código desta API não lê estas
# variáveis; ficam só como referência dos nomes atuais das chaves.
SUPABASE_URL=https://xozcsujnjzoinqhifgfm.supabase.co
# Pública (substitui a antiga "anon"). Pode ir no app e no navegador.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_sua_chave
# SECRETA (substitui a antiga "service_role"). Ignora o RLS: só em servidor.
SUPABASE_SECRET_KEY=sb_secret_sua_chave

# ─── Banco de dados ──────────────────────────────────────
# Local (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rede_apoio?schema=public
# Supabase: painel → Connect → Session pooler
# DATABASE_URL=postgresql://postgres.xozcsujnjzoinqhifgfm:SENHA_DO_BANCO@aws-0-ca-central-1.pooler.supabase.com:5432/postgres

REDIS_URL=redis://localhost:6379

CORS_ORIGINS=http://localhost:3000,http://localhost:5173

SHARE_BASE_URL=http://localhost:5173/track
SHARE_MAX_DURATION_MIN=60

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
